# ============================================================================
# ETERNIA ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env and fill in the values from your new Supabase project
# and LiveKit Cloud dashboard.

# --- Supabase Project Credentials ---
# Found in: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL="https://<your-project-id>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<your-supabase-anon-key>"
VITE_SUPABASE_PROJECT_ID="<your-project-id>"

# Mirrors used by scripts and Edge Functions
SUPABASE_URL="https://<your-project-id>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<your-supabase-anon-key>"

# --- LiveKit Cloud WebSocket URL ---
# Found in: LiveKit Cloud Console -> Project Settings -> Keys
VITE_LIVEKIT_URL="wss://<your-project-subdomain>.livekit.cloud"
